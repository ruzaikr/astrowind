---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Master Programming Fundamentals with an Industry Expert',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- Hero Widget ******************* -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Book a Free Consultation',
        href: '#',
        icon: 'tabler:calendar',
      },
      { text: 'Learn more', href: '#features' },
    ]}
  >
    <Fragment slot="title">
      Master Programming Fundamentals with an <span class="text-accent dark:text-white highlight">Industry Expert</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        Overwhelmed by YouTube tutorials and dense textbooks? Get personalized, one-on-one guidance from a seasoned software engineer who’s passionate about teaching. I bridge the gap between what's taught in school and what's actually needed on the job, helping you build real-world coding skills and confidence.
      </span>
    </Fragment>

    <Fragment slot="media">
      <div class="flex items-center justify-center h-full w-full max-w-3xl">
        <video controls autoplay loop muted class="w-full rounded-lg shadow-lg">
          <source src="assets/videos/hero.mp4" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      </div>
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->
  <Note />

  <!-- Features Widget *************** -->
  <Features
    id="features"
    tagline="Benefits"
    title="Why Learn With Me?"
    subtitle="Each session equips you with in-demand skills and industry insights."
    items={[
      {
        title: 'One-on-One Attention',
        description: 'No generic lectures—everything is tailored to your pace and interests.',
        icon: 'tabler:user',
      },
      {
        title: 'Practical, Real-World Examples',
        description: 'Learn techniques actually used by professional developers, not just textbook theory.',
        icon: 'tabler:device-desktop-analytics',
      },
      {
        title: 'Hands-On Projects',
        description: 'Build a portfolio as you learn, reinforcing concepts through real assignments.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'Clear Explanations & Friendly Guidance',
        description: 'Complex topics simplified, ensuring you truly understand before moving on.',
        icon: 'tabler:info-circle',
      },
      {
        title: 'Immediate Feedback',
        description: 'Identify and correct mistakes early to develop solid coding habits.',
        icon: 'tabler:messages',
      },
      {
        title: 'Career-Focused Mentorship',
        description: 'Get insights on best practices, interview prep, and what employers want.',
        icon: 'tabler:briefcase',
      },
    ]}
  />

  <!-- Content Widget **************** -->
  <Content
    isReversed
    tagline="My Methodology"
    title="A Proven Approach to Mastery"
    items={[
      {
        title: 'Foundation First',
        description: 'We solidify basic concepts before tackling advanced topics, ensuring a strong skill base.',
      },
      {
        title: 'In-Demand Tools',
        description: 'Focus on languages and frameworks that the industry currently values.',
      },
      {
        title: 'Cross-Platform Skills',
        description: 'Your knowledge won’t be limited—learn principles that adapt to various environments.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=2070&q=80',
      alt: 'Student focused image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Invest in Strong Foundations</h3>
      When you start with the right fundamentals, you’re building skills that will pay off for years to come.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->
  <Content
    isAfterContent
    items={[
      {
        title: 'Personal Curriculum',
        description: 'We define a roadmap based on your specific goals—acing a class, preparing for a bootcamp, or landing a junior dev job.',
      },
      {
        title: 'Flexible Scheduling',
        description: 'Sessions fit into your life, not the other way around.',
      },
      {
        title: 'Online & Accessible',
        description: 'Learn from anywhere with live, interactive sessions.',
      },
      {
        title: 'Multimedia Resources',
        description: 'Go beyond the sessions with curated readings, exercises, and video walkthroughs.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?auto=format&fit=crop&w=2194&q=80',
      alt: 'Customized learning image',
    }}
  >
    <Fragment slot="content">Tailored learning paths for your unique goals.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->
  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Engaging Lessons',
        description: 'Interactive examples and clear logic make coding less intimidating and more fun.',
      },
      {
        title: 'Continuous Improvement',
        description: 'I stay updated with tech trends so you’re always learning relevant skills.',
      },
      {
        title: 'Time & Effort Saved',
        description: 'Skip trial-and-error. Guided learning means you progress faster.',
      },
      {
        title: 'Community Support',
        description: 'Join a network of learners and pros for ongoing advice and encouragement.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?auto=format&fit=crop&w=2070&q=80',
      alt: 'Student success image',
    }}
  >
    <Fragment slot="content">Become confident and independent in your coding journey.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->
  <Steps
    title="Start Your Coding Journey in Three Simple Steps"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Book a Free Consultation</span>',
        description:
          "We'll discuss your goals, current skill level, and schedule. No commitment—just a friendly chat to see if we’re a good fit.",
        icon: 'tabler:calendar',
      },
      {
        title: 'Step 2: <span class="font-medium">Get a Personalized Plan</span>',
        description:
          "I’ll craft a custom syllabus tailored to your needs, focusing on what matters most to you.",
        icon: 'tabler:list-check',
      },
      {
        title: 'Step 3: <span class="font-medium">Start Learning</span>',
        description:
          'Begin your first session, build confidence, and watch your skills grow with consistent, guided practice.',
        icon: 'tabler:school',
      },
      {
        title: 'Ready!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?auto=format&fit=crop&w=987&q=80',
      alt: 'Getting started image',
    }}
  />

  <!-- Features2 Widget ************** -->
  <Features2
    title="Common Learning Tools"
    subtitle="I integrate a variety of resources to enhance your learning."
    tagline="Resources"
    items={[
      {
        title: 'Live Interactive Sessions',
        description: 'Real-time explanations, Q&A, and coding demos make sessions truly engaging.',
        icon: 'tabler:video',
      },
      {
        title: 'Recorded Lessons',
        description: 'Revisit and review concepts anytime at your own pace.',
        icon: 'tabler:player-play',
      },
      {
        title: 'Hands-On Assignments',
        description: 'Reinforce new concepts by putting them into immediate practice.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'Regular Check-Ins',
        description: 'Track progress, adjust the plan, and celebrate every milestone.',
        icon: 'tabler:clock',
      },
      {
        title: 'Mentoring & Guidance',
        description: 'Industry insights, career advice, and interview prep to help you stand out.',
        icon: 'tabler:bulb',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- BlogLatestPosts Widget ******* -->
  <BlogLatestPosts
    title="Stay Informed with Expert Tips & Insights"
    information={`Check out my blog for industry trends, study strategies, and more. Each post helps you keep improving, even outside of our sessions.`}
  />

  <!-- FAQs Widget ******************* -->
  <FAQs
    title="Frequently Asked Questions"
    subtitle="Clear answers to help you feel confident about working with me."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Why choose one-on-one tutoring?',
        description:
          "Personalized guidance ensures faster progress than generic video tutorials. We focus on your goals, challenges, and learning style.",
      },
      {
        title: 'Do I need prior coding experience?',
        description:
          "Not at all! I work with absolute beginners as well as those refining advanced skills.",
      },
      {
        title: 'What languages or technologies do you cover?',
        description:
          "We can focus on popular languages and frameworks that align with your goals—like JavaScript, Python, or modern web technologies.",
      },
      {
        title: 'How are sessions conducted?',
        description:
          "All sessions are online, using video calls and screen-sharing for an interactive, hands-on experience.",
      },
      {
        title: 'What if I need flexible scheduling?',
        description:
          "We’ll arrange sessions that fit your life, whether that's weekends, evenings, or other times.",
      },
      {
        title: 'Is there ongoing support?',
        description:
          "Yes! Between sessions, I'm available for quick questions and guidance as you practice.",
      },
    ]}
  />

  <!-- Stats Widget ****************** -->
  <Stats
    stats={[
      { title: 'Students Mentored', amount: '50+' },
      { title: 'Positive Feedback', amount: '95%' },
      { title: 'Projects Built', amount: 'Dozens' },
      { title: 'Guidance Hours', amount: 'Countless' },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book a Free Consultation',
        href: '#',
        icon: 'tabler:calendar',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to Level Up Your Coding Skills?
    </Fragment>

    <Fragment slot="subtitle">
      Don’t let confusion hold you back. Start your journey to becoming a confident, capable coder today.
    </Fragment>
  </CallToAction>
</Layout>
